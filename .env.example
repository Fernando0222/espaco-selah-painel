# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o arquivo ".env" de verdade para o git ou para a hospedagem
# publicamente — ele contém segredos.

# Ambiente
DJANGO_PRODUCTION=False
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-gerada
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados. DB_ENGINE=sqlite (padrão) não precisa de mais nada — é o
# que o dev local e hospedagens sem MySQL disponível (ex.: plano grátis do
# PythonAnywhere) usam. Troque para DB_ENGINE=mysql e preencha os DB_* só
# quando a hospedagem realmente tiver MySQL disponível.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# HSTS: manter em 0 até confirmar que o HTTPS funciona em produção
DJANGO_HSTS_SECONDS=0

# E-mail (usado para o link de "esqueci minha senha").
# Em desenvolvimento (DJANGO_PRODUCTION=False) os e-mails aparecem no
# terminal, então estas variáveis podem ficar em branco. Em produção,
# preencha com uma conta de e-mail de verdade (ex.: o e-mail profissional
# que já vem com a hospedagem da Hostinger).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Espaço Selah <nao-responda@espacoselah.com.br>
